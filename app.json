{
  "expo": {
    "name": "今日随访",
    "slug": "patient-followup-local",
    "scheme": "patientfollowup",
    "version": "2.0.18",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.local.patientfollowup"
    },
    "android": {
      "package": "com.local.patientfollowup",
      "versionCode": 34,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问照片以选择患者心电图或可选的同意证明。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
