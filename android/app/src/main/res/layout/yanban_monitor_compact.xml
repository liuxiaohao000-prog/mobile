<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/yanban_monitor_status_dot"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日随访 · 监测中"
            android:textColor="@color/yanban_monitor_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="低功耗"
            android:textColor="@color/yanban_monitor_accent"
            android:textSize="10sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/yanban_monitor_badge_bg" />
    </LinearLayout>
    <TextView
        android:id="@+id/yanban_monitor_compact_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="待随访 0   ·   已完成 0   ·   总入组 0"
        android:textColor="@color/yanban_monitor_secondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>